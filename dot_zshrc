# dot_zshrc
# Main zsh initialization file that sources modular configs.
# Does not include all configuration inline.

# Install tree-sitter-cli if not already installed (for NeoVim treesitter)
if ! command -v tree-sitter >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
  npm install -g tree-sitter-cli 2>/dev/null || true
fi

# Source all modular zsh configs (00-homebrew.zsh puts Homebrew on PATH).
for config in ~/.config/zsh/*.zsh(N); do
  source "$config"
done

# Activate mise LAST so its runtime shims take precedence over Homebrew on PATH.
# Homebrew can pull go/node in as transitive deps; activating mise after the
# Homebrew shellenv guarantees the mise.toml-pinned runtimes win in every shell,
# including non-interactive scripts. See README "Runtime vs tool strategy".
if command -v mise >/dev/null 2>&1; then
  mise trust --yes 2>/dev/null || true
  eval "$(mise activate zsh)"
fi

# Keep `go install` output in ~/go/bin, never in mise's GOROOT. mise points GOBIN
# at the runtime dir by default, so go-installed tools can corrupt the pinned go.
# Override GOBIN after activation and put ~/go/bin on PATH for gopls et al.
export GOBIN="$HOME/go/bin"
export PATH="$HOME/go/bin:$PATH"

# Load shared aliases if they exist
if [ -f ~/.config/shell_aliases ]; then
  source ~/.config/shell_aliases
fi
