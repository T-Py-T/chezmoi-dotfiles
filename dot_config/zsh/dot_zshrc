# dot_config/zsh/dot_zshrc
# Initializes zsh environment with mise tools.
# Loads shared aliases and user customizations.

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Source all modular zsh configs
for config in ~/.config/zsh/*.zsh(N); do
  source "$config"
done

# Load shared aliases if they exist
if [ -f ~/.config/shell_aliases ]; then
  source ~/.config/shell_aliases
fi
