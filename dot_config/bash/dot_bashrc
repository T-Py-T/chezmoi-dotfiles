# dot_config/bash/dot_bashrc
# Modular bash config: Homebrew path setup and prompt initialization.
# Sourced by ~/.bashrc via the glob pattern for ~/.config/bash/*.bash.
# Does not re-activate mise (handled in ~/.bashrc entry point).

# Source Homebrew if available (Linux path: /home/linuxbrew, macOS: /opt/homebrew)
if [ -f ~/.config/bash/00-homebrew.bash ]; then
  source ~/.config/bash/00-homebrew.bash
fi

# Initialize starship prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi
