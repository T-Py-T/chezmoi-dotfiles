// .devcontainer/devcontainer.json
// Defines a disposable, reusable devcontainer for testing the chezmoi dotfiles setup.
// postStartCommand runs startup.sh which installs mise tools, applies dotfiles via chezmoi,
// installs brew packages, and bootstraps NeoVim plugins.
{
  "name": "chezmoi-dotfiles-test",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/chezmoi-dotfiles",
  "overrideCommand": false,
  "remoteUser": "taylor",
  "postStartCommand": "bash .devcontainer/startup.sh",
  "containerEnv": {
    "CHEZMOI_SOURCE_DIR": "/workspaces/chezmoi-dotfiles",
    "DEVCONTAINER": "1"
  }
}
