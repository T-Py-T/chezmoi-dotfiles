#!/usr/bin/env bash
# scripts/run_once_before_setup.tmpl
# Installs Homebrew if missing and validates it.
# Does not run Brewfile bundle steps.

set -eou pipefail

if [ "${SKIP_BREW:-0}" = "1" ]; then
  echo "Skipping Homebrew setup because SKIP_BREW=1."
  exit 0
fi

{{- if not (lookPath "brew") }}
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
{{- end }}

[ -f /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
if ! brew doctor; then
  >&2 echo "Please fix the issues with Homebrew and run again."
  exit 1
fi
