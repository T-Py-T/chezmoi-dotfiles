#!/usr/bin/env bash
# scripts/run_once_before_setup.tmpl
# Installs Homebrew if missing and activates it for the current shell session.
# Does not run Brewfile bundle steps (that is handled by run_10_homebrew).

set -eou pipefail

if [ "${SKIP_BREW:-0}" = "1" ]; then
  echo "Skipping Homebrew setup because SKIP_BREW=1."
  exit 0
fi

{{- if not (lookPath "brew") }}
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
{{- end }}

# Activate brew for the remainder of this script so subsequent chezmoi scripts
# can call 'brew' directly. Covers both Linux and macOS install paths.
if [ -f /home/linuxbrew/.linuxbrew/bin/brew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [ -f /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Skip brew doctor in containers - it warns about system configs that don't matter there.
if [ "${DEVCONTAINER:-0}" != "1" ] && [ ! -f /.dockerenv ]; then
  if ! brew doctor; then
    >&2 echo "Please fix the issues with Homebrew and run again."
    exit 1
  fi
fi
