#!/usr/bin/env bash
# scripts/run_10_homebrew
# Runs brew bundle using the OS-specific Brewfile.
# Skipped in devpod environments to keep startup fast (tools via mise).

set -euo pipefail

# Skip brew bundle in containerized environments
if [ -f /.dockerenv ] || [ -f /.devcontainer ]; then
  echo "Skipping brew bundle in containerized environment (tools via mise)."
  exit 0
fi

brew update

source_dir="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
brewfile_path=""
case "$(uname -s)" in
  Linux)
    brewfile_path="${source_dir}/brew/linux/dot_Brewfile.tmpl"
    ;;
  Darwin)
    brewfile_path="${source_dir}/brew/macos/dot_Brewfile.tmpl"
    ;;
esac

if [ -n "$brewfile_path" ] && [ -f "$brewfile_path" ]; then
  brew bundle --file "$brewfile_path" --cleanup
else
  brew bundle --global --cleanup
fi

brew upgrade
