#!/usr/bin/env bash
# scripts/run_10_homebrew
# Runs brew bundle using the environment-appropriate Brewfile.
# Devcontainers use the minimal devcontainer Brewfile instead of the full laptop one.

set -euo pipefail

source_dir="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"

# chezmoi runs each script in its own process, so the `brew shellenv` that
# run_once_before_setup evaluated does not reach here. On a machine where that
# script just installed Homebrew, `brew` is not yet on PATH at all.
if ! command -v brew >/dev/null 2>&1; then
  if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  elif [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  else
    echo "Homebrew is not installed and was not found in any standard location." >&2
    exit 1
  fi
fi

# Detect devcontainer via the DEVCONTAINER env var set in devcontainer.json.
# Falls back to /.dockerenv for containers that don't set the env var.
is_container=0
if [ "${DEVCONTAINER:-0}" = "1" ] || [ -f /.dockerenv ]; then
  is_container=1
fi

if [ "$is_container" = "1" ]; then
  brewfile_path="${source_dir}/brew/devcontainer/dot_Brewfile.tmpl"
  echo "Container environment detected. Using devcontainer Brewfile."
  if [ -f "$brewfile_path" ]; then
    brew bundle --file "$brewfile_path"
  else
    echo "Devcontainer Brewfile not found at $brewfile_path, skipping."
  fi
  exit 0
fi

# Laptop / workstation: use OS-specific Brewfile
brew update

brewfile_path=""
case "$(uname -s)" in
  Linux)
    brewfile_path="${source_dir}/brew/linux/dot_Brewfile.tmpl"
    ;;
  Darwin)
    brewfile_path="${source_dir}/brew/macos/dot_Brewfile.tmpl"
    ;;
esac

if [ -n "$brewfile_path" ] && [ -f "$brewfile_path" ]; then
  brew bundle install --file "$brewfile_path"
  brew bundle cleanup --file "$brewfile_path" --force
else
  brew bundle install --global
  brew bundle cleanup --global --force
fi

brew upgrade
