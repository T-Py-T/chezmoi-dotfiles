# brew/devcontainer/dot_Brewfile.tmpl
# Homebrew bundle for devcontainer / DevPod environments.
# Minimal set: only what is needed to support NeoVim and the terminal profile.
# Does not include laptop-only tools (k8s clients, cloud CLIs, GUI apps, etc.).

# NeoVim and its runtime dependencies
brew "neovim"
brew "luarocks"        # Lua package manager (used by some plugins for rocks deps)
brew "tree-sitter-cli" # Tree-sitter CLI binary (nvim-treesitter needs this to compile parsers;
                       # the `tree-sitter` formula was split in 2025 and now only provides libtree-sitter.so)

# LSP servers (matched against vim.lsp.enable() calls in init.lua)
brew "pyright"         # Python LSP
# gopls is provided via `go install` in the macOS Brewfile; install here on demand

# NeoVim search and navigation (Telescope live_grep, file find, fuzzy find)
brew "ripgrep"
brew "fd"
brew "fzf"

# Git tooling
brew "git"
brew "lazygit"         # Git TUI, used inside nvim

# Terminal essentials
brew "bat"             # Syntax-highlighted cat
brew "eza"             # Modern ls replacement
brew "htop"            # Process viewer
brew "jq"              # JSON processor
brew "tmux"            # Terminal multiplexer
brew "wget"
brew "zoxide"          # Smarter cd

# Kubernetes
brew "k9s"             # Terminal UI for kubernetes clusters
brew "kubectx"         # kubectx + kubens (switch contexts and namespaces)

# Shell tooling
brew "pre-commit"      # Git hook manager
brew "shellcheck"      # Shell script linter
brew "starship"        # Cross-shell prompt
