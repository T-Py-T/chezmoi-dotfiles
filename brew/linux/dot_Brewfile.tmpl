# brew/linux/dot_Brewfile.tmpl
# Homebrew bundle for Linux workstations (including WSL).
# Does not include macOS-only casks or formulas.
# Language runtimes (python, go, rust, node) are managed by mise, not here.

tap "aws/tap", trusted: true
tap "oven-sh/bun", trusted: true

# Language runtime manager (python, go, node, rust pinned in mise.toml)
brew "mise"
brew "uv"

# NeoVim and its runtime dependencies
brew "neovim"
brew "luarocks"
brew "tree-sitter-cli"

# Search and navigation
brew "fd"
brew "fzf"
brew "ripgrep"

# Git tooling
brew "gh"
brew "git"
brew "git-lfs"
brew "lazygit"

# Terminal essentials
brew "bat"
brew "coreutils"
brew "curl"
brew "eza"
brew "htop"
brew "jq"
brew "tmux"
brew "wget"
brew "zoxide"

# Shell tooling
brew "direnv"
brew "pre-commit"
brew "shellcheck"
brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Kubernetes
brew "kubectl"
brew "kubectx"

# Linters and dev tools
brew "act"
brew "actionlint"
brew "chezmoi"
brew "commitizen"
brew "go-task"
brew "hadolint"
brew "herdr"
brew "opencode"

# Agent runtime dependencies
brew "dolt"             # Beads shared-server mode (embedded mode needs no daemon)
brew "oven-sh/bun/bun"  # OMP package and extension runtime

# Cloud
brew "aws-sam-cli"

# Hardware
brew "ykpers"
