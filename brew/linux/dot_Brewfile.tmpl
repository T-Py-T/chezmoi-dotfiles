# brew/linux/dot_Brewfile.tmpl
# Homebrew bundle for Linux workstations (including WSL).
# Does not include macOS-only casks or formulas.
# Language runtimes (python, go, rust, node) are managed by mise, not here.

tap "aws/tap"

# Core utilities
brew "bat"
brew "coreutils"
brew "curl"
brew "eza"
brew "fd"
brew "fzf"
brew "htop"
brew "jq"
brew "ripgrep"
brew "tree-sitter"
brew "wget"
brew "zoxide"

# Git tooling
brew "gh"
brew "git"
brew "git-lfs"
brew "lazygit"

# NeoVim
brew "luarocks"
brew "neovim"

# Shell and prompt
brew "direnv"
brew "pre-commit"
brew "shellcheck"
brew "starship"
brew "tmux"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Linters and dev tools
brew "actionlint"
brew "act"
brew "chezmoi"
brew "commitizen"
brew "go-task"
brew "hadolint"

# Kubernetes
brew "kubectl"
brew "kubectx"

# AWS
brew "aws-sam-cli"

# Other
brew "ykpers"
