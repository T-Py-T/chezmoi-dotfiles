# brew/macos/dot_Brewfile.tmpl
# Homebrew bundle for macOS (Macbook).
# Includes casks, GUI apps, and macOS-specific tools.

tap "defenseunicorns/tap", trusted: true
tap "derailed/k9s", trusted: true
tap "hashicorp/tap", trusted: true
tap "hudochenkov/sshpass", trusted: true
tap "huseyinbabal/tap", trusted: true
tap "local/legacy", trusted: true
tap "oven-sh/bun", trusted: true
tap "slp/krunkit", trusted: true
tap "y3owk1n/tap", trusted: true

# NeoVim and its runtime dependencies
brew "neovim"

# LSP servers (matched against vim.lsp.enable() calls in init.lua)
brew "pyright"         # Python LSP (gopls is provided via `go install` below)

# Languages and runtimes
# python, go, node, rust are managed by mise (see mise.toml). Brew owns mise itself
# plus runtime-adjacent tools (uv, openjdk, yarn) that mise does not handle.
brew "mise"
brew "openjdk@17"
brew "uv"
brew "yarn"

# Build tools
brew "clang-format"
brew "cmake"
brew "conan"
brew "just"
brew "llvm"
brew "llvm@21"
brew "make"
brew "openblas"

# Search and navigation
brew "fzf"
brew "ripgrep"

# Git tooling
brew "gh"
brew "git"
brew "git-filter-repo"
brew "glab"

# Containers
brew "crane"
brew "docker"
brew "grype"
brew "hadolint"
brew "podman-compose"
brew "qemu"
brew "syft"

# Kubernetes
brew "argocd"
brew "helm"
brew "kind"
brew "kube-ps1"
brew "kubectx"
brew "kubernetes-cli"
brew "minikube"
brew "talosctl"

# Cloud
brew "awscli"
brew "sops"

# CI/CD and dev tools
brew "act"
brew "golangci-lint"
brew "goreleaser"
brew "herdr"
brew "opencode"
brew "pre-commit"

# Database
brew "dolt"             # Beads shared-server mode (embedded mode needs no daemon)
brew "postgresql@14"

# Terminal essentials
brew "btop"
brew "dysk"
brew "fastfetch"
brew "jq"
brew "p7zip"
brew "rsync"
brew "starship"
brew "tldr"
brew "tmux"
brew "tree"
brew "w3m"
brew "wget"
brew "yazi"
brew "yq"

# Disk and image tools
brew "squashfs"
brew "xorriso"

# Misc
brew "cmatrix"
brew "exiftool"
brew "sl"

# Tap-specific CLIs
brew "defenseunicorns/tap/uds"
brew "defenseunicorns/tap/zarf"
brew "derailed/k9s/k9s"
brew "hashicorp/tap/terraform"
brew "hudochenkov/sshpass/sshpass"
brew "huseyinbabal/tap/taws"
brew "local/legacy/podman@5.8.3"   # pinned podman engine
brew "oven-sh/bun/bun"
brew "slp/krunkit/krunkit"

# Casks (GUI apps)

# Browsers
cask "firefox"

# Terminal emulators
cask "ghostty"
cask "iterm2"

# Fonts
cask "font-jetbrains-mono-nerd-font"

# Editors and IDEs
cask "cursor"
cask "vscodium"

# AI assistants
cask "claude"
cask "claude-code"
cask "cmux"
cask "codex"

# Communication
cask "discord"

# Productivity
cask "obsidian"
cask "onlyoffice"
cask "pearcleaner"

# Window management and input
cask "karabiner-elements"
cask "rectangle"
cask "y3owk1n/tap/neru"

# Containers and devcontainers
cask "devpod"
cask "kubecontext"
cask "podman-desktop"
cask "utm"

# Media
cask "airflow"
cask "gstreamer-runtime"
cask "vlc"

# Hardware and 3D printing
cask "arduino-ide@nightly"
cask "balenaetcher"
cask "bambu-studio"

# VS Code extensions (Homebrew vscode stanza)
vscode "anthropic.claude-code"
vscode "anysphere.cursorpyright"
vscode "anysphere.remote-containers"
vscode "anysphere.remote-ssh"
vscode "github.vscode-github-actions"
vscode "github.vscode-pull-request-github"
vscode "gitlab.gitlab-workflow"
vscode "ms-azuretools.vscode-containers"
vscode "ms-azuretools.vscode-docker"
vscode "ms-kubernetes-tools.vscode-kubernetes-tools"
vscode "ms-python.debugpy"
vscode "ms-python.python"
vscode "pkief.material-icon-theme"
vscode "redhat.vscode-yaml"
vscode "sanjulaganepola.github-local-actions"
vscode "shd101wyy.markdown-preview-enhanced"
vscode "vscodevim.vim"

# Go binaries
go "golang.org/x/tools/gopls"
go "github.com/tsenart/vegeta/v12"
