# brew/macos/dot_Brewfile.tmpl
# Homebrew bundle for macOS (Macbook).
# Includes casks, GUI apps, and macOS-specific tools.
# Language runtimes (python, go, rust, node) are managed by mise, not here.

tap "aws/tap"
tap "hashicorp/tap"
tap "homebrew/bundle"

# Core utilities
brew "ack"
brew "bat"
brew "coreutils"
brew "curl"
brew "eza"
brew "fd"
brew "fzf"
brew "htop"
brew "jq"
brew "ripgrep"
brew "tree-sitter"
brew "wget"
brew "zoxide"

# Git tooling
brew "gh"
brew "git"
brew "git-lfs"
brew "lazygit"

# NeoVim
brew "luarocks"
brew "neovim"

# Shell and prompt
brew "direnv"
brew "pinentry-mac"
brew "pre-commit"
brew "shellcheck"
brew "starship"
brew "tmux"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Linters and dev tools
brew "actionlint"
brew "act"
brew "chezmoi"
brew "commitizen"
brew "go-task"
brew "hadolint"

# Kubernetes
brew "kubectl"
brew "kubectx"

# AWS and infrastructure
brew "aws-sam-cli"
brew "conftest"
brew "opa"
brew "terraform-docs"
brew "tflint"
brew "hashicorp/tap/packer"
brew "hashicorp/tap/vault"
brew "hashicorp/tap/waypoint"

# Security
brew "hopenpgp-tools"
brew "ykpers"

# Applications (macOS only)
cask "1password"
cask "docker"
cask "drawio"
cask "font-fira-code-nerd-font"
cask "font-meslo-lg-nerd-font"
cask "gpg-suite-no-mail"
cask "insomnia"
cask "notion"
cask "notunes"
cask "slack"
cask "tailscale"
cask "tuple"
cask "visual-studio-code"
cask "wezterm"
cask "zoom"

# VSCode extensions
vscode "davidanson.vscode-markdownlint"
vscode "eamodio.gitlens"
vscode "equinusocio.vsc-material-theme"
vscode "equinusocio.vsc-material-theme-icons"
vscode "github.copilot"
vscode "github.copilot-chat"
vscode "github.vscode-github-actions"
vscode "golang.go"
vscode "hashicorp.terraform"
vscode "ms-azuretools.vscode-docker"
vscode "ms-vscode-remote.remote-containers"
vscode "ms-vscode.makefile-tools"
vscode "ms-vsliveshare.vsliveshare"
vscode "streetsidesoftware.code-spell-checker"
vscode "visualstudioexptteam.vscodeintellicode"
